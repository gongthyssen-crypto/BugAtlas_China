.illustration-card { padding: 26rpx; }
.card-heading { display: flex; align-items: flex-start; justify-content: space-between; }
.sub-title { font-size: 32rpx; font-weight: 700; }
.illustration, .illustration-empty { width: 100%; height: 500rpx; margin-top: 24rpx; border-radius: 7rpx; background: #d8ddc9; }
.illustration-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; color: #6a7557; text-align: center; }
.illustration-empty text { margin-bottom: 18rpx; font-size: 86rpx; }
.illustration-card .btn { width: 100%; margin-top: 18rpx; }
.switch-row { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; color: #626a57; font-size: 23rpx; }
.create-button { width: 100%; margin-top: 30rpx; }
.work-card { margin-top: 22rpx; overflow: hidden; border: 2rpx solid #263024; background: #f7f2e6; box-shadow: 10rpx 12rpx 0 rgba(72,82,58,.12); }
.work-card image { display: block; width: 100%; height: 410rpx; background: #d8ddc9; }
.detail-card image { height: 560rpx; }
.work-meta { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; }
.work-meta text { float: left; margin-right: 18rpx; color: #a95031; font-size: 20rpx; }
.work-meta view view { font-size: 27rpx; font-weight: 700; }
.work-meta small { color: #7a7e6d; font-size: 19rpx; }
.work-actions { display: flex; gap: 8rpx; }
.work-actions button { margin: 0; padding: 10rpx 16rpx; color: #52613d; background: transparent; font-family: inherit; font-size: 21rpx; line-height: 1.2; }
.work-actions button::after { border-color: #798365; }
.publish { width: 100%; margin-top: 30rpx; }
