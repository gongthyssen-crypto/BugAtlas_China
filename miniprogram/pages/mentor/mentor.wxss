.source-row { display: flex; align-items: center; gap: 18rpx; margin-top: 28rpx; color: #7a7e6c; font-size: 22rpx; }
.hero-candidate { min-height: 280rpx; overflow: hidden; }
.candidate-number { color: #d7ae57; font-size: 20rpx; letter-spacing: 4rpx; }
.candidate-name { margin-top: 42rpx; font-size: 62rpx; font-weight: 700; }
.latin { margin-top: 16rpx; color: #b8bda8; font-size: 22rpx; font-style: italic; }
.wing-mark { position: absolute; right: 28rpx; bottom: -25rpx; color: rgba(243,238,221,.12); font-size: 210rpx; transform: rotate(-18deg); }
.evidence-grid { display: grid; grid-template-columns: 1fr 1fr; margin-top: 18rpx; overflow: hidden; border: 2rpx solid #bfc0ad; border-radius: 10rpx; background: rgba(247,242,230,.8); }
.candidate-tab { grid-column: 1 / 3; padding: 22rpx 26rpx; background: #d8ddc9; font-weight: 700; }
.candidate-tab text { margin-right: 18rpx; color: #a95031; font-size: 20rpx; letter-spacing: 2rpx; }
.evidence-column { padding: 24rpx; }
.evidence-column.no { border-left: 2rpx solid #d0cdbb; }
.evidence-item { margin-top: 14rpx; font-size: 23rpx; line-height: 1.55; }
.yes .evidence-item { color: #425f38; }
.no .evidence-item { color: #86513d; }
.verify { grid-column: 1 / 3; padding: 24rpx; border-top: 2rpx solid #d0cdbb; }
.verify-item { display: flex; align-items: center; gap: 16rpx; margin-top: 16rpx; }
.verify-item text { display: inline-flex; width: 42rpx; height: 42rpx; align-items: center; justify-content: center; border: 2rpx solid #a95031; border-radius: 50%; color: #a95031; font-size: 19rpx; }
.version-tabs { display: flex; width: max-content; padding: 7rpx; border: 2rpx solid #bfc0ad; border-radius: 999rpx; }
.version-tabs view { padding: 13rpx 28rpx; border-radius: 999rpx; color: #747966; font-size: 23rpx; }
.version-tabs .active { color: #f7f2e6; background: #52613d; }
.explanation { font-size: 27rpx; line-height: 1.85; }
.audio-button { display: flex; align-items: center; gap: 15rpx; margin: 28rpx 0 0; padding: 0; color: #a95031; background: transparent; font-family: inherit; font-size: 23rpx; text-align: left; }
.audio-button::after { border: 0; }
.audio-button text { display: inline-flex; width: 54rpx; height: 54rpx; align-items: center; justify-content: center; border: 2rpx solid #a95031; border-radius: 50%; }
.safety { margin-top: 24rpx; color: #8a4a32; font-size: 23rpx; font-weight: 700; }
.studio-button { width: 100%; margin-top: 32rpx; }
